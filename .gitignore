# Binaries
/fastclaw
*.exe

# Runtime artifacts written by the gateway when it treats this dir
# as an agent workspace (e.g. during local dev). Don't commit these.
/MEMORY.md
/sessions/
*.exe~
*.dll
*.so
*.dylib

# Build output
/bin/
/dist/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
*.prof

# Go workspace file
go.work
go.work.sum

# Dependency directories
vendor/
node_modules/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Environment and secrets
.env
.env.*
*.pem
*.key

# Config with secrets (users create their own)
config.json

# Debug
debug/
__debug_bin*
DESIGN.md

# Air hot reload
tmp/
.air.toml

# Web build artifacts (embedded at build time)
internal/setup/web/
web/out/
web/.next/

openclaw.json

# Third-party skill source archives (used by external integrate scripts).
# Keep them out of git; the project ships only curated skills under skills/.
temp_*/
*.tar.gz

# Runtime state — manager.sh and `fastclaw daemon` both produce these.
# PID file moved to ~/.fastclaw/fastclaw.pid; legacy <repo>/fastclaw.pid
# is also caught here so old artefacts don't sneak back in.
fastclaw.pid
logs/

# CodeWiz / agent local plans + scratch state, not meant for VCS.
.codewiz/
